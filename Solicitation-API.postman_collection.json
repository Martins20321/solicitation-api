{
  "info": {
    "_postman_id": "f3a1e6a0-7b1c-4e2a-9c4e-8e6d6a9d6b11",
    "name": "Solicitation API",
    "description": "Coleção para testar a Solicitation API (Sea Tecnologia hiring challenge). Configure o header Authorization (Bearer Token) manualmente em cada requisição protegida após o login.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Gabriel Silva\",\n  \"email\": \"gabriel@example.com\",\n  \"password\": \"123456\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"gabriel@example.com\",\n  \"password\": \"123456\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Solicitations (Client)",
      "item": [
        {
          "name": "List my solicitations (paged)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "PASTE_CLIENT_TOKEN_HERE", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/solicitations?page=0&size=20&sort=createdAt,desc",
              "host": ["{{base_url}}"],
              "path": ["solicitations"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" },
                { "key": "sort", "value": "createdAt,desc" }
              ]
            }
          }
        },
        {
          "name": "Get solicitation by id",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "PASTE_CLIENT_TOKEN_HERE", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/solicitations/1",
              "host": ["{{base_url}}"],
              "path": ["solicitations", "1"]
            }
          }
        },
        {
          "name": "Create draft",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "PASTE_CLIENT_TOKEN_HERE", "type": "string" }]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/solicitations",
              "host": ["{{base_url}}"],
              "path": ["solicitations"]
            }
          }
        },
        {
          "name": "Save step 1 (service type, title, description)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "PASTE_CLIENT_TOKEN_HERE", "type": "string" }]
            },
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"serviceType\": \"MAINTENANCE\",\n  \"title\": \"Air conditioning repair\",\n  \"description\": \"The office air conditioning unit is leaking water and making unusual noise.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/solicitations/1/step1",
              "host": ["{{base_url}}"],
              "path": ["solicitations", "1", "step1"]
            }
          }
        },
        {
          "name": "Save step 2 (address)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "PASTE_CLIENT_TOKEN_HERE", "type": "string" }]
            },
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cep\": \"70040-010\",\n  \"number\": \"100\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/solicitations/1/step2",
              "host": ["{{base_url}}"],
              "path": ["solicitations", "1", "step2"]
            }
          }
        },
        {
          "name": "Save step 3 (priority, date, value, terms)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "PASTE_CLIENT_TOKEN_HERE", "type": "string" }]
            },
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"priority\": \"HIGH\",\n  \"preferredDate\": \"2026-12-01\",\n  \"estimatedValue\": 350.00,\n  \"termsAccepted\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/solicitations/1/step3",
              "host": ["{{base_url}}"],
              "path": ["solicitations", "1", "step3"]
            }
          }
        },
        {
          "name": "Submit solicitation",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "PASTE_CLIENT_TOKEN_HERE", "type": "string" }]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/solicitations/1/submit",
              "host": ["{{base_url}}"],
              "path": ["solicitations", "1", "submit"]
            }
          }
        }
      ]
    },
    {
      "name": "Analyst",
      "item": [
        {
          "name": "Get solicitation by id",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "PASTE_ANALYST_TOKEN_HERE", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/analyst/solicitations/1",
              "host": ["{{base_url}}"],
              "path": ["analyst", "solicitations", "1"]
            }
          }
        },
        {
          "name": "Search solicitations",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "PASTE_ANALYST_TOKEN_HERE", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/analyst/solicitations/search?q=&status=SUBMITTED&serviceType=MAINTENANCE&priority=HIGH&state=DF&dateFrom=2026-01-01&dateTo=2026-12-31&page=0&size=20&sort=createdAt,desc",
              "host": ["{{base_url}}"],
              "path": ["analyst", "solicitations", "search"],
              "query": [
                { "key": "q", "value": "" },
                { "key": "status", "value": "SUBMITTED" },
                { "key": "serviceType", "value": "MAINTENANCE" },
                { "key": "priority", "value": "HIGH" },
                { "key": "state", "value": "DF" },
                { "key": "dateFrom", "value": "2026-01-01" },
                { "key": "dateTo", "value": "2026-12-31" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" },
                { "key": "sort", "value": "createdAt,desc" }
              ]
            }
          }
        },
        {
          "name": "Start analysis",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "PASTE_ANALYST_TOKEN_HERE", "type": "string" }]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/analyst/solicitations/1/start",
              "host": ["{{base_url}}"],
              "path": ["analyst", "solicitations", "1", "start"]
            }
          }
        },
        {
          "name": "Decide (approve/reject)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "PASTE_ANALYST_TOKEN_HERE", "type": "string" }]
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"APPROVE\",\n  \"comment\": \"All requirements met, approved for execution.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/analyst/solicitations/1/decide",
              "host": ["{{base_url}}"],
              "path": ["analyst", "solicitations", "1", "decide"]
            }
          }
        }
      ]
    },
